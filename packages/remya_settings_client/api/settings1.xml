<node>
  <interface name="top.remya.settings.Settings1">
    <!-- system-information returns api_version and per-ID value/error observations;
         its 16 about.* info fields reject Set with ReadOnly. about is app metadata.
         hostname reads static/runtime/saved names and conflict state.
         Set about.0f142010 renames; Resolve hostname accepts system or settings.
         background reads saved and system values; Resolve background accepts system or settings.
         accent reads the Material seed. fonts, font-search:<query> and font:<family> read fonts.
         default-apps reads saved/system associations and conflict state.
         default-applications:<query>, default-types:<query>, default-candidates:<comma-separated-types>
         read applications, MIME/scheme types and supported candidates.
         Set defaults.* accepts JSON application and types; shortcut types are fixed.
         Resolve default-apps accepts system or settings.
         installed-apps and installed-app:<id> read desktop/package inventory.
         installed-apps:<JSON query/source/sort> filters and sorts the same inventory.
         calendar-date:<YYYY-MM-DD> formats a date under system LC_TIME.
         Set installed.c3c4a29c accepts JSON id/token and returns removed after readback.
         Native/system uninstall uses the authorized private helper; manual entries reject uninstall.
         Get appimages reads the AppImage library; appimages.* Set values are documented in docs/public-api.md.
         Changed topics background, accent, fonts, default-apps, installed-apps and appimages report updates. -->
    <!-- external-tools:time/system/appearance lists installed external configurators.
         Set the catalog tool ID with open launches only its fixed ordinary-user executable.
         input-method-tools lists installed input-method configurators. Set time-more.fcitx5 or
         time-more.ibus with open launches the fixed tool as the ordinary user. -->
    <!-- Get bluetooth returns live BlueZ adapters/devices and asynchronous operation/prompt/error state.
         Set bluetooth.* accepts JSON requests, including pairing responses and cancellation.
         Changed bluetooth reports verified state and Agent prompts; see docs/public-api.md.
         No Bluetooth preferences or keys are persisted by Settings. -->
    <!-- Get account-information reads the service username and Settings-owned avatar.
         The username readout rejects Set; Set your-info.58484bbb accepts an image path
         and normalized crop rectangle. Changed account-information reports avatar updates. -->
    <method name="Get">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Set">
      <arg type="s" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="List">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Search">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Open">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Resolve">
      <arg type="s" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Reload">
      <arg type="s" direction="out"/>
    </method>
    <method name="Restart">
      <arg type="s" direction="out"/>
    </method>
    <method name="Close"><arg type="s" direction="out"/></method>
    <method name="Quit">
      <arg type="s" direction="out"/>
    </method>
    <signal name="Changed"><arg type="s"/><arg type="s"/></signal>
  </interface>
</node>
