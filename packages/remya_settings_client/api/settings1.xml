<node>
  <interface name="top.remya.settings.Settings1">
    <!-- system-information returns api_version and per-ID value/error observations;
         its 16 about.* info fields reject Set with ReadOnly. about is app metadata.
         hostname reads static/runtime/saved names and conflict state.
         Set about.0f142010 renames; Resolve hostname accepts system or settings.
         background reads saved and system values; Resolve background accepts system or settings.
         accent reads the Material seed. fonts, font-search:<query> and font:<family> read fonts.
         Changed topics background, accent and fonts report updates. -->
    <method name="Get">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Set">
      <arg type="s" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="List">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Search">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Open">
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Resolve">
      <arg type="s" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Reload">
      <arg type="s" direction="out"/>
    </method>
    <method name="Restart">
      <arg type="s" direction="out"/>
    </method>
    <method name="Close"><arg type="s" direction="out"/></method>
    <method name="Quit">
      <arg type="s" direction="out"/>
    </method>
    <signal name="Changed"><arg type="s"/><arg type="s"/></signal>
  </interface>
</node>
